# Database
DATABASE_URL="postgresql://neon_user:password@aws-region.neon.tech/monetize?sslmode=require"

# Cache
REDIS_URL="redis://default:password@upstash_region.upstash.io:port"

# Authentication
JWT_SECRET="your-ultra-secure-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Communication
RESEND_API_KEY="re_..."
EMAIL_FROM="Connect@monetize.com"

# Media
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Payments
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="webhook-secret"

# AI Integration
GROQ_API_KEY="gsk_..."
OPENAI_API_KEY="sk-..."

# Client URL (for CORS and Emails)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

# Real-time (ZegoCloud)
ZEGOCLOUD_APP_ID="your-app-id"
ZEGOCLOUD_SERVER_SECRET="your-server-secret"
